{
    "name": "@team-affix/dpm",
    "version": "0.1.0",
    "description": "Decentralized Package Manager: content-addressed packages stored across many independent registries.",
    "license": "MIT",
    "author": "Team Affix",
    "main": "dist/core/index.js",
    "types": "dist/core/index.d.ts",
    "exports": {
        ".": "./dist/core/index.js",
        "./server": "./dist/server/index.js",
        "./client": "./dist/client/index.js"
    },
    "bin": {
        "dpm": "dist/client/cli.js",
        "dpm-server": "dist/server/main.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src test",
        "format": "prettier --write src test",
        "prepublishOnly": "npm run build && npm run lint && npm test"
    },
    "dependencies": {
        "commander": "^14.0.0",
        "tar-stream": "^3.1.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@types/node": "^22.15.30",
        "eslint": "^9.32.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.39.0",
        "vitest": "^4.1.12"
    }
}
